# ---- MongoDB Atlas ----
MONGO_URI=mongodb+srv://<db_username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=skillsprint_ai

# ---- OpenAI ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- App ----
BACKEND_URL=http://localhost:8000
ENV=development
